<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:background="#F4F5EF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="28sp" android:textStyle="bold"
            android:textColor="#246B4E" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/screen_title" android:textSize="22sp" android:textStyle="bold"
            android:textColor="#18372C" android:layout_marginBottom="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/screen_description" android:textSize="16sp"
            android:textColor="#52635A" android:layout_marginBottom="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/product_id" android:text="@string/product_label"
            android:textColor="#18372C" android:textSize="16sp" />
        <EditText android:id="@+id/product_id" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:inputType="number" android:singleLine="true"
            android:hint="@string/product_hint" android:imeOptions="actionNext"
            android:textColor="#18372C" android:textColorHint="#66756E"
            android:layout_marginBottom="20dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:labelFor="@id/quantity" android:text="@string/quantity_label"
            android:textColor="#18372C" android:textSize="16sp" />
        <EditText android:id="@+id/quantity" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:inputType="number" android:singleLine="true" android:text="1"
            android:imeOptions="actionDone" android:textColor="#18372C"
            android:layout_marginBottom="20dp" />
        <Button android:id="@+id/check_button" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/check_button" android:backgroundTint="#246B4E"
            android:textColor="#FFFFFF" />
        <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp" android:visibility="gone"
            android:contentDescription="@string/loading" />
        <TextView android:id="@+id/result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:textSize="18sp" android:textColor="#18372C"
            android:accessibilityLiveRegion="polite" android:text="@string/initial_result" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/stock_note"
            android:textSize="14sp" android:textColor="#52635A" />
    </LinearLayout>
</ScrollView>
